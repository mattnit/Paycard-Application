    {
      "name": "Springboot Paycard App",
      "item": [
        {
          "name": "hello json check",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Paycard was created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Paycard has a name\", function () {\r",
                  "    pm.expect(jsonData.name).to.eql(\"Matthew\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Paycard has a id\", function () {\r",
                  "    pm.expect(jsonData.id).to.eql(1);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains an id\", function () {\r",
                  "    pm.expect(jsonData.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.collectionVariables.set(\"paycardId\", jsonData.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/user",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "user"
              ]
            }
          },
          "response": []
        },
        {
          "name": "hello status check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response says hello\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"Hello\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/hello",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "hello"
              ]
            }
          },
          "response": []
        }
